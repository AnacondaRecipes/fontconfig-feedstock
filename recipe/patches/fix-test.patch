             prefix="fontconfig.", suffix=".host.conf", mode="w", delete_on_close=False
         )
-        self._builddir = self._env.get(
+        # os.environ.copy() on Windows can normalize key casing so a
+        # plain-string lookup of "builddir"/"srcdir" silently misses even
+        # when the variable is present; look up case-insensitively.
+        def _env_get_ci(name, default):
+            for k, v in self._env.items():
+                if k.lower() == name.lower():
+                    return v
+            return default
+        self._builddir = _env_get_ci(
             "builddir", str(Path(__file__).parents[2] / "build")
         )
-        self._srcdir = self._env.get("srcdir", str(Path(__file__).parents[2]))
+        self._srcdir = _env_get_ci("srcdir", str(Path(__file__).parents[2]))
